# Copy this file to .env.local and fill in the values. Never commit .env.local.

# ── Site ────────────────────────────────────────────────────────────────
# Your live domain, no trailing slash (used for SEO, sitemap and social previews).
NEXT_PUBLIC_SITE_URL=https://lumosbysonia.com

# ── Sanity (content) ───────────────────────────────────────────────────
# sanity.io/manage → your project → Project ID
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
# Any long random string; also pasted into the Sanity webhook settings.
SANITY_REVALIDATE_SECRET=

# ── Supabase (enquiry storage) ─────────────────────────────────────────
# Supabase → Project Settings → API. The service role key is SECRET: server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Resend (enquiry emails) — optional; emails are skipped if empty ────
RESEND_API_KEY=
# Address that receives new enquiries (defaults to the email in src/config/site.ts).
ENQUIRY_NOTIFY_EMAIL=
# Sender. Use onboarding@resend.dev until you verify your own domain in Resend.
RESEND_FROM_EMAIL=Lumos by Sonia <onboarding@resend.dev>
